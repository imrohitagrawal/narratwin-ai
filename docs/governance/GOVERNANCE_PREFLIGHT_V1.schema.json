{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narratwin.local/schemas/GOVERNANCE_PREFLIGHT_V1.schema.json",
  "title": "GovernancePreflightV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "issue_number", "branch", "objective", "status_decision", "scope"],
  "properties": {
    "schema_version": {"const": "GovernancePreflightV1"},
    "issue_number": {"type": "integer"},
    "branch": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1, "maxLength": 2000},
    "status_decision": {"const": "update-minimally"},
    "change_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exact_paths",
        "maximum_additions_plus_deletions",
        "deletions_grant_credit",
        "per_file_charged_lines"
      ],
      "properties": {
        "exact_paths": {"$ref": "#/$defs/positiveInteger"},
        "maximum_additions_plus_deletions": {"$ref": "#/$defs/positiveInteger"},
        "deletions_grant_credit": {"const": false},
        "per_file_charged_lines": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 128,
          "propertyNames": {"type": "string", "minLength": 1, "maxLength": 512},
          "additionalProperties": {"$ref": "#/$defs/positiveInteger"}
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "allowed_prefixes", "forbidden"],
      "properties": {
        "required": {"$ref": "#/$defs/pathList"},
        "allowed_prefixes": {"$ref": "#/$defs/pathList"},
        "forbidden": {"$ref": "#/$defs/pathList"}
      }
    }
  },
  "$defs": {
    "positiveInteger": {"type": "integer", "minimum": 1},
    "pathList": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 512}
    }
  }
}
