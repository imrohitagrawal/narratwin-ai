{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narratwin.local/schemas/cut1-controlled-presenter-evidence-v1.schema.json",
  "title": "Cut1ControlledPresenterEvidenceV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "authority", "cells", "approvals", "dependencyPosture", "providerPosture", "observability", "acceptance"],
  "properties": {
    "schemaVersion": {"const": "Cut1ControlledPresenterEvidenceV1"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseCommit", "sourceSha256", "scriptSha256", "evaluationSha256", "approvalSha256"],
      "properties": {
        "baseCommit": {"const": "ab97b6eecba6db9c66c37d19b29257c7398f3ab7"},
        "sourceSha256": {"const": "49b75655ddbbe43145a35215069bce2751de66393b39eb68d69b584d7ecfcc5e"},
        "scriptSha256": {"const": "3b071180d4723784d84f5005644fc5a2aa5ef6b6adb6f7caeba2de76d68be435"},
        "evaluationSha256": {"const": "cb50de12ce2debb3d52308892428b9711e5efb41fe2ad59b175563809e7d314b"},
        "approvalSha256": {"const": "89199278feabfdcee21fffe4a9ad4d157dd7fc9a11a2529562876cb6ecc74702"}
      }
    },
    "cells": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/cell"},
      "allOf": [
        {"contains": {"type": "object", "required": ["presenterId", "aspectRatio"], "properties": {"presenterId": {"const": "meera"}, "aspectRatio": {"const": "LANDSCAPE"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "required": ["presenterId", "aspectRatio"], "properties": {"presenterId": {"const": "meera"}, "aspectRatio": {"const": "PORTRAIT"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "required": ["presenterId", "aspectRatio"], "properties": {"presenterId": {"const": "raj"}, "aspectRatio": {"const": "LANDSCAPE"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "required": ["presenterId", "aspectRatio"], "properties": {"presenterId": {"const": "raj"}, "aspectRatio": {"const": "PORTRAIT"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "required": ["presenterId", "aspectRatio"], "properties": {"presenterId": {"const": "myra"}, "aspectRatio": {"const": "LANDSCAPE"}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "required": ["presenterId", "aspectRatio"], "properties": {"presenterId": {"const": "myra"}, "aspectRatio": {"const": "PORTRAIT"}}}, "minContains": 1, "maxContains": 1}
      ]
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["speechApprovalCurrent", "artifactApprovalStatus", "humanApprovalStatus"],
      "properties": {
        "speechApprovalCurrent": {"const": true},
        "artifactApprovalStatus": {"const": "TECHNICAL_ONLY"},
        "humanApprovalStatus": {"const": "NOT_AUTHORIZED_ISSUE_432"}
      }
    },
    "dependencyPosture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audioOwnership", "providerAuthority", "humanStudyAuthority", "derivativeReadiness"],
      "properties": {
        "audioOwnership": {"const": "ISSUE_368_HANDOFF_REQUIRED"},
        "providerAuthority": {"const": "ISSUE_449_NOT_AUTHORIZED"},
        "humanStudyAuthority": {"const": "ISSUE_432_NOT_AUTHORIZED"},
        "derivativeReadiness": {"const": "RAJ_MYRA_NOT_READY"}
      }
    },
    "providerPosture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "enabled", "configSha256", "credentialCount", "egressAttemptCount", "providerCallCount", "retryCount", "spendMicrousd"],
      "properties": {
        "mode": {"const": "LOCAL_KEY_FREE_DISABLED_EXTERNAL"},
        "enabled": {"const": false},
        "configSha256": {"$ref": "#/$defs/sha256"},
        "credentialCount": {"const": 0},
        "egressAttemptCount": {"const": 0},
        "providerCallCount": {"const": 0},
        "retryCount": {"const": 0},
        "spendMicrousd": {"const": 0}
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenantId", "projectId", "requestId", "traceId", "runId", "provenanceRef", "deletionRef", "rawSensitiveContentPresent", "providerPayloadPresent"],
      "properties": {
        "tenantId": {"$ref": "#/$defs/id"},
        "projectId": {"$ref": "#/$defs/id"},
        "requestId": {"$ref": "#/$defs/id"},
        "traceId": {"$ref": "#/$defs/id"},
        "runId": {"$ref": "#/$defs/id"},
        "provenanceRef": {"$ref": "#/$defs/id"},
        "deletionRef": {"$ref": "#/$defs/id"},
        "rawSensitiveContentPresent": {"const": false},
        "providerPayloadPresent": {"const": false}
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["technicalDecision", "cut1Decision", "humanEvidencePresent"],
      "properties": {
        "technicalDecision": {"const": "ENTRY_ORACLE_TARGET_ONLY"},
        "cut1Decision": {"const": "BLOCKED_NOT_ACCEPTED"},
        "humanEvidencePresent": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._:-]*$"},
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["presenterId", "language", "aspectRatio", "lineage", "rights", "artifact", "metrics", "decision"],
      "properties": {
        "presenterId": {"enum": ["meera", "raj", "myra"]},
        "language": {"const": "en"},
        "aspectRatio": {"enum": ["LANDSCAPE", "PORTRAIT"]},
        "lineage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["presenterBindingSha256", "narrationSha256", "audioSha256", "captionSha256", "manifestSha256", "evaluationSha256", "metricEvidenceSha256", "approvalCurrent"],
          "properties": {
            "presenterBindingSha256": {"$ref": "#/$defs/sha256"},
            "narrationSha256": {"$ref": "#/$defs/sha256"},
            "audioSha256": {"$ref": "#/$defs/sha256"},
            "captionSha256": {"$ref": "#/$defs/sha256"},
            "manifestSha256": {"$ref": "#/$defs/sha256"},
            "evaluationSha256": {"$ref": "#/$defs/sha256"},
            "metricEvidenceSha256": {"$ref": "#/$defs/sha256"},
            "approvalCurrent": {"const": true}
          }
        },
        "rights": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fictionalIdentity", "derivativeAuthorized", "originalOverwritten", "provenanceSha256", "deletionRef"],
          "properties": {
            "fictionalIdentity": {"const": true},
            "derivativeAuthorized": {"const": true},
            "originalOverwritten": {"const": false},
            "provenanceSha256": {"$ref": "#/$defs/sha256"},
            "deletionRef": {"$ref": "#/$defs/id"}
          }
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mediaKind", "mimeType", "regularFile", "decoded", "placeholder", "sha256", "byteCount", "durationMs", "width", "height", "audioPresent", "captionsPresent"],
          "properties": {
            "mediaKind": {"const": "VIDEO"},
            "mimeType": {"const": "video/mp4"},
            "regularFile": {"const": true},
            "decoded": {"const": true},
            "placeholder": {"const": false},
            "sha256": {"$ref": "#/$defs/sha256"},
            "byteCount": {"type": "integer", "minimum": 1, "maximum": 50000000},
            "durationMs": {"type": "integer", "minimum": 1, "maximum": 300000},
            "width": {"type": "integer", "minimum": 1, "maximum": 7680},
            "height": {"type": "integer", "minimum": 1, "maximum": 7680},
            "audioPresent": {"const": true},
            "captionsPresent": {"const": true}
          }
        },
        "metrics": {"$ref": "#/$defs/metrics"},
        "decision": {"const": "PASSED_INDEPENDENTLY"}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gazeRatio", "maxOffCameraMs", "lipOffsetP95Ms", "maxLipErrorMs", "captionWordAccuracy", "captionCoverage", "maxCaptionGapMs", "citationCoverage", "acceptedUnsupportedClaims", "abstentionRate", "identityMismatchCount", "severeMotionDefectCount", "maxRepeatedGesture", "keyboardPassed", "screenReaderPassed", "visibleFocusPassed", "reducedMotionPassed", "contrastRatio", "scriptEvaluationP95Ms", "previewAfterReadyMs", "repeatBindingEqual"],
      "properties": {
        "gazeRatio": {"type": "number", "minimum": 0.8, "maximum": 1},
        "maxOffCameraMs": {"type": "integer", "minimum": 0, "maximum": 2000},
        "lipOffsetP95Ms": {"type": "number", "minimum": 0, "maximum": 80},
        "maxLipErrorMs": {"type": "integer", "minimum": 0, "maximum": 200},
        "captionWordAccuracy": {"type": "number", "minimum": 0.98, "maximum": 1},
        "captionCoverage": {"type": "number", "minimum": 0.98, "maximum": 1},
        "maxCaptionGapMs": {"type": "integer", "minimum": 0, "maximum": 1000},
        "citationCoverage": {"const": 1},
        "acceptedUnsupportedClaims": {"const": 0},
        "abstentionRate": {"const": 1},
        "identityMismatchCount": {"const": 0},
        "severeMotionDefectCount": {"const": 0},
        "maxRepeatedGesture": {"type": "integer", "minimum": 0, "maximum": 2},
        "keyboardPassed": {"const": true},
        "screenReaderPassed": {"const": true},
        "visibleFocusPassed": {"const": true},
        "reducedMotionPassed": {"const": true},
        "contrastRatio": {"type": "number", "minimum": 4.5},
        "scriptEvaluationP95Ms": {"type": "number", "minimum": 0, "maximum": 20000},
        "previewAfterReadyMs": {"type": "number", "minimum": 0, "maximum": 5000},
        "repeatBindingEqual": {"const": true}
      }
    }
  }
}
