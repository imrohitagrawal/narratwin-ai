{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://narratwin.local/schemas/adversarial-convergence-framework-v1.schema.json",
  "title":"Adversarial convergence framework v1",
  "oneOf":[{"$ref":"#/$defs/caseCorpus"},{"$ref":"#/$defs/invariantMatrix"},{"$ref":"#/$defs/redFreeze"}],
  "$defs":{
    "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "gitOid":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "identifier":{"type":"string","pattern":"^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$","maxLength":96},
    "path":{"type":"string","minLength":1,"maxLength":512,"pattern":"^[A-Za-z0-9._/-]+$","not":{"pattern":"(^/|^~|//|(^|/)\\.{1,2}(/|$))"}},
    "jsonValue":{
      "oneOf":[
        {"type":["string","number","boolean","null"]},
        {"type":"array","maxItems":64,"items":{"$ref":"#/$defs/jsonValue"}},
        {"type":"object","maxProperties":64,"propertyNames":{"type":"string","maxLength":128},"additionalProperties":{"$ref":"#/$defs/jsonValue"}}
      ]
    },
    "stage":{"enum":["BOUNDS","PARSE","SCHEMA","CANONICAL_IDENTITY","INDEPENDENT_TRUST","AUTHORIZATION","GRAPH_CONFLICT","PHASE_VERDICT"]},
    "stimulus":{
      "type":"object",
      "additionalProperties":false,
      "required":["kind","payload"],
      "properties":{
        "kind":{"enum":["FILESYSTEM","JSON","DOCUMENT","PIPELINE","OUTCOME","MUTATION_SET","EXECUTION_LEDGER","REVIEWS","EXPECTATION_BOUNDARY","ROUTE","CHECKPOINT","RESOURCE"]},
        "payload":{"type":"object","minProperties":1,"maxProperties":32,"additionalProperties":{"$ref":"#/$defs/jsonValue"}}
      }
    },
    "case":{
      "type":"object",
      "additionalProperties":false,
      "required":["caseId","threatId","testClass","stimulus"],
      "properties":{
        "caseId":{"type":"string","pattern":"^ACP-C[0-9]{3}$"},
        "threatId":{"enum":["ACP-T01","ACP-T02","ACP-T03","ACP-T04","ACP-T05","ACP-T06","ACP-T07","ACP-T08","ACP-T09","ACP-T10","ACP-T11","ACP-T12"]},
        "testClass":{"enum":["POSITIVE","NEGATIVE","BOUNDARY","MALFORMED","DELETION","CORRUPTION","REORDERING","DUPLICATION","SUBSTITUTION","MAX_CARDINALITY"]},
        "stimulus":{"$ref":"#/$defs/stimulus"}
      }
    },
    "caseCorpus":{
      "type":"object",
      "additionalProperties":false,
      "required":["schemaVersion","corpusId","caseCount","threatUniverse","cases"],
      "properties":{
        "schemaVersion":{"const":"AdversarialConvergenceCaseCorpusV1"},
        "corpusId":{"const":"ACP-FRAMEWORK-CASES-V1-N40"},
        "caseCount":{"const":40},
        "threatUniverse":{"type":"array","prefixItems":[{"const":"ACP-T01"},{"const":"ACP-T02"},{"const":"ACP-T03"},{"const":"ACP-T04"},{"const":"ACP-T05"},{"const":"ACP-T06"},{"const":"ACP-T07"},{"const":"ACP-T08"},{"const":"ACP-T09"},{"const":"ACP-T10"},{"const":"ACP-T11"},{"const":"ACP-T12"}],"items":false},
        "cases":{"type":"array","minItems":40,"maxItems":40,"items":{"$ref":"#/$defs/case"}}
      }
    },
    "invariant":{
      "type":"object",
      "additionalProperties":false,
      "required":["invariantId","threatId","stage","rule","evidenceClass"],
      "properties":{
        "invariantId":{"$ref":"#/$defs/identifier"},
        "threatId":{"$ref":"#/$defs/identifier"},
        "stage":{"$ref":"#/$defs/stage"},
        "rule":{"type":"string","minLength":1,"maxLength":1000},
        "evidenceClass":{"enum":["TEST","SOURCE","HUMAN_ONLY","NON_GOAL"]},
        "testIds":{"type":"array","maxItems":64,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":160}}
      }
    },
    "invariantMatrix":{
      "type":"object",
      "additionalProperties":false,
      "required":["schemaVersion","matrixId","threatUniverse","processingOrder","invariants","limits"],
      "properties":{
        "schemaVersion":{"const":"AdversarialInvariantMatrixV1"},
        "matrixId":{"$ref":"#/$defs/identifier"},
        "threatUniverse":{"type":"array","minItems":1,"maxItems":64,"uniqueItems":true,"items":{"$ref":"#/$defs/identifier"}},
        "processingOrder":{"type":"array","prefixItems":[{"const":"BOUNDS"},{"const":"PARSE"},{"const":"SCHEMA"},{"const":"CANONICAL_IDENTITY"},{"const":"INDEPENDENT_TRUST"},{"const":"AUTHORIZATION"},{"const":"GRAPH_CONFLICT"},{"const":"PHASE_VERDICT"}],"items":false},
        "invariants":{"type":"array","minItems":1,"maxItems":64,"items":{"$ref":"#/$defs/invariant"}},
        "limits":{
          "type":"object","additionalProperties":false,
          "required":["maxBytes","maxDepth","maxMembers","maxFindings","maxCases"],
          "properties":{
            "maxBytes":{"type":"integer","minimum":1,"maximum":65536},
            "maxDepth":{"type":"integer","minimum":1,"maximum":32},
            "maxMembers":{"type":"integer","minimum":1,"maximum":4096},
            "maxFindings":{"type":"integer","minimum":1,"maximum":256},
            "maxCases":{"type":"integer","minimum":1,"maximum":64}
          }
        }
      }
    },
    "artifact":{
      "type":"object","additionalProperties":false,
      "required":["path","blob","sha256"],
      "properties":{"path":{"$ref":"#/$defs/path"},"blob":{"$ref":"#/$defs/gitOid"},"sha256":{"$ref":"#/$defs/sha256"}}
    },
    "protectedArtifact":{"type":"object","additionalProperties":false,"required":["path","blob","sha256","protectedSha256"],"properties":{"path":{"const":"scripts/quality/adversarial_convergence.py"},"blob":{"$ref":"#/$defs/gitOid"},"sha256":{"$ref":"#/$defs/sha256"},"protectedSha256":{"$ref":"#/$defs/sha256"}}},
    "corpusArtifact":{
      "type":"object","additionalProperties":false,
      "required":["path","blob","sha256","semanticSha256"],
      "properties":{"path":{"const":"docs/governance/adversarial-convergence-framework-cases-v1.json"},"blob":{"$ref":"#/$defs/gitOid"},"sha256":{"$ref":"#/$defs/sha256"},"semanticSha256":{"$ref":"#/$defs/sha256"}}
    },
    "reviewReceipt":{
      "type":"object","additionalProperties":false,
      "required":["role","reviewer","disposition","head","tree","url","content","contentSha256"],
      "properties":{
        "role":{"enum":["ARCHITECTURE_SCOPE_PHASE","SECURITY_TRUST","READABILITY_FEASIBILITY","MUTATION_FALSE_PASS"]},
        "reviewer":{"type":"string","minLength":1,"maxLength":160},
        "disposition":{"const":"PASS"},
        "head":{"$ref":"#/$defs/gitOid"},"tree":{"$ref":"#/$defs/gitOid"},
        "url":{"type":"string","pattern":"^https://github\\.com/imrohitagrawal/narratwin-ai/issues/435#issuecomment-[0-9]+$"},
        "content":{"type":"string","minLength":1,"maxLength":8192},
        "contentSha256":{"$ref":"#/$defs/sha256"}
      }
    },
    "redFreeze":{
      "type":"object","additionalProperties":false,
      "required":["schemaVersion","issue","activation","authorityEffect","correction","c2","artifacts","reviews"],
      "properties":{
        "schemaVersion":{"const":"AdversarialConvergenceRedFreezeV1"},"issue":{"const":435},
        "activation":{"const":"NONE"},"authorityEffect":{"const":"NO_AUTHORITY_EFFECT"},
        "correction":{"type":"object","additionalProperties":false,"required":["rejectedHead","wave","authors"],"properties":{"rejectedHead":{"const":"8d83713ed09dc626e24f1fe063e6afd9cfa5e8e9"},"wave":{"const":1},"authors":{"type":"array","minItems":1,"maxItems":8,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":160}}}},
        "c2":{"type":"object","additionalProperties":false,"required":["head","tree","diffSha256"],"properties":{"head":{"$ref":"#/$defs/gitOid"},"tree":{"$ref":"#/$defs/gitOid"},"diffSha256":{"$ref":"#/$defs/sha256"}}},
        "artifacts":{
          "type":"object","additionalProperties":false,
          "required":["corpus","schema","acceptanceTest","skeleton","dispatcher","guardrail"],
          "properties":{
            "corpus":{"$ref":"#/$defs/corpusArtifact"},
            "schema":{"allOf":[{"$ref":"#/$defs/artifact"},{"properties":{"path":{"const":"docs/governance/adversarial-convergence-framework-v1.schema.json"}}}]},
            "acceptanceTest":{"allOf":[{"$ref":"#/$defs/artifact"},{"properties":{"path":{"const":"tests/unit/test_adversarial_convergence.py"}}}]},
            "skeleton":{"$ref":"#/$defs/protectedArtifact"},
            "dispatcher":{"allOf":[{"$ref":"#/$defs/artifact"},{"properties":{"path":{"const":"scripts/quality/check_quality_stage.py"}}}]},
            "guardrail":{"allOf":[{"$ref":"#/$defs/artifact"},{"properties":{"path":{"const":"scripts/guardrails_check.py"}}}]}
          }
        },
        "reviews":{"type":"array","prefixItems":[{"allOf":[{"$ref":"#/$defs/reviewReceipt"},{"properties":{"role":{"const":"ARCHITECTURE_SCOPE_PHASE"}}}]},{"allOf":[{"$ref":"#/$defs/reviewReceipt"},{"properties":{"role":{"const":"SECURITY_TRUST"}}}]},{"allOf":[{"$ref":"#/$defs/reviewReceipt"},{"properties":{"role":{"const":"READABILITY_FEASIBILITY"}}}]},{"allOf":[{"$ref":"#/$defs/reviewReceipt"},{"properties":{"role":{"const":"MUTATION_FALSE_PASS"}}}]}],"items":false,"uniqueItems":true}
      }
    }
  }
}
