{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-next-glob-compat.mjs && next build",
    "typecheck": "tsc --noEmit",
    "start": "node .next/standalone/server.js",
    "lint": "node scripts/check-next-glob-compat.mjs && eslint",
    "test": "node scripts/check-next-glob-compat.mjs && vitest run",
    "test:smoke": "playwright test"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "minimatch": "10.2.5",
    "postcss": "8.5.23",
    "sharp": "^0.35.5",
    "source-map-js": "1.2.2",
    "@next/eslint-plugin-next": {
      "fast-glob": "npm:tinyglobby@0.2.17"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.8",
    "lighthouse": "^13.4.1",
    "playwright": "^1.61.1",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "sharp@0.35.5": true
  }
}
